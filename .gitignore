# Maven
**/target/               # Ignora todos los directorios "target"
!.mvn/wrapper/maven-wrapper.jar  # No ignorar este archivo específico
!**/src/main/**/target/    # No ignorar el "target" en src/main
!**/src/test/**/target/    # No ignorar el "target" en src/test

### IntelliJ IDEA ###
.idea/modules.xml
.idea/jarRepositories.xml
.idea/compiler.xml
.idea/libraries/
*.iws
*.iml
*.ipr

